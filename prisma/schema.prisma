generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  STYLIST
  EMPLOYEE
  ADMIN
}

enum OrderStatus {
  pending
  inProgress
  completed
  delivered
  cancelled
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
}

model User {
  id String @id @default(uuid()) @db.Uuid
  role UserRole @default(CLIENT)
  firstName String
  lastName String
  email String @unique
  phone String @unique
  passwordHash String
  googleSubject String? @unique
  refreshTokenHash String?
  sessionVersion Int @default(0)
  profileImage String @default("")
  active Boolean @default(true)
  mustChangePassword Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stylist StylistProfile?
  personnel Personnel?
  clientOrders Order[] @relation("ClientOrders")
  clientMeasurements Measurement[] @relation("ClientMeasurements")
  appointments Appointment[] @relation("ClientAppointments")
  notifications ClientNotification[]
  @@index([role, active])
}

model StylistProfile {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  businessName String
  about String @default("")
  specialties String[]
  rating Decimal @default(0) @db.Decimal(2,1)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  personnel Personnel[]
  orders Order[]
  measurements Measurement[]
  catalogItems CatalogItem[]
  appointments Appointment[] @relation("StylistAppointments")
  @@index([rating])
}

model Personnel {
  id String @id @default(uuid()) @db.Uuid
  stylistId String @db.Uuid
  firstName String
  lastName String
  email String
  phone String
  specialization String
  hireDate DateTime @default(now())
  active Boolean @default(true)
  userId String? @unique @db.Uuid
  stylist StylistProfile @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@unique([stylistId, email])
  @@index([stylistId, active])
}

enum MeasurementSource {
  stylist
  client
  employee
  legacy
}

model Measurement {
  id String @id @default(uuid()) @db.Uuid
  stylistId String @db.Uuid
  clientId String? @db.Uuid
  clientConfirmedAt DateTime?
  clientName String
  modelName String?
  modelType String?
  source MeasurementSource @default(legacy)
  validatedAt DateTime?
  validatedById String? @db.Uuid
  clientPhone String
  values Json
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stylist StylistProfile @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  client User? @relation("ClientMeasurements", fields: [clientId], references: [id])
  @@index([stylistId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
}

model Order {
  id String @id @default(uuid()) @db.Uuid
  stylistId String @db.Uuid
  clientId String? @db.Uuid
  clientConfirmedAt DateTime?
  clientName String
  clientPhone String
  description String
  status OrderStatus @default(pending)
  totalPrice Decimal @db.Decimal(12,2)
  currency String @default("XOF")
  notes String?
  measurements Json @default("{}")
  durationDays Int?
  dueAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stylist StylistProfile @relation(fields: [stylistId], references: [id])
  client User? @relation("ClientOrders", fields: [clientId], references: [id])
  notifications ClientNotification[]
  @@index([stylistId, status, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
}

model CatalogItem {
  id String @id @default(uuid()) @db.Uuid
  stylistId String @db.Uuid
  title String
  description String @default("")
  imageUrl String
  price Decimal @db.Decimal(12,2)
  currency String @default("XOF")
  availableColors String[]
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stylist StylistProfile @relation(fields: [stylistId], references: [id])
  likes CatalogLike[]
  @@index([active, createdAt(sort: Desc)])
  @@index([stylistId, active])
}

model CatalogLike {
  catalogItemId String @db.Uuid
  visitorId String @db.Uuid
  createdAt DateTime @default(now())
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  @@id([catalogItemId, visitorId])
}

model Appointment {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  stylistId String @db.Uuid
  service String
  startsAt DateTime
  status AppointmentStatus @default(pending)
  notes String?
  createdAt DateTime @default(now())
  client User @relation("ClientAppointments", fields: [clientId], references: [id])
  stylist StylistProfile @relation("StylistAppointments", fields: [stylistId], references: [id])
  // Active-slot uniqueness is enforced by the partial index in SQL migrations.
  @@index([clientId, startsAt])
}

model ClientNotification {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  orderId String? @db.Uuid
  message String
  createdAt DateTime @default(now())
  readAt DateTime?
  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  @@index([clientId, createdAt(sort: Desc), id(sort: Desc)])
}
