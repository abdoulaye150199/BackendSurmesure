NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://surmesure:surmesure@localhost:5434/surmesure?schema=public
# Total Prisma connections are approximately API instance count × pool size.
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10
# Optional direct migration connection for Neon. Without it, the script removes -pooler from DATABASE_URL.
# DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
JWT_ACCESS_SECRET=change-me-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-too-with-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=https://surmesure-front.vercel.app,https://surmesure.liggeypro.com,http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000,http://localhost:8080
LOG_LEVEL=info
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=false
# Public Google OAuth Web Client ID. Omit to disable Google authentication.
# GOOGLE_CLIENT_ID=123456789-example.apps.googleusercontent.com
