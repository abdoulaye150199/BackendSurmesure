NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://surmesure:surmesure@localhost:5434/surmesure?schema=public&connection_limit=20
JWT_ACCESS_SECRET=change-me-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-too-with-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000,http://localhost:8080
LOG_LEVEL=info

# Facultatif : fournir les deux variables ensemble pour créer/mettre à jour
# le Super Admin lors de `npm run prisma:seed`. Ne commitez jamais le vrai mot de passe.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
