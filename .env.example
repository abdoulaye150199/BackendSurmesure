NODE_ENV=development
PORT=3001
# Choisir explicitement postgresql ou mysql et utiliser l'URL du même moteur.
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://surmesure:surmesure@localhost:5434/surmesure?schema=public
# Pour MySQL, remplacer DATABASE_PROVIDER et DATABASE_URL par exemple par :
# DATABASE_PROVIDER=mysql
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# PostgreSQL/Neon seulement : URL directe réservée aux migrations.
# DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10
JWT_ACCESS_SECRET=change-me-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-too-with-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=https://surmesure-front.vercel.app,https://surmesure.liggeypro.com,http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000,http://localhost:8080
LOG_LEVEL=info
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=false
