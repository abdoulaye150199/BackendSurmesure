NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://surmesure:surmesure@localhost:5434/surmesure?schema=public
# Total Prisma connections are approximately API instance count × pool size.
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10
# Facultatif : connexion directe réservée aux migrations (prioritaire sur DATABASE_URL_UNPOOLED).
# Avec Neon, sans cette variable, le script enlève automatiquement le suffixe -pooler.
# DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
JWT_ACCESS_SECRET=change-me-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-too-with-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=https://surmesure-front.vercel.app,https://surmesure.liggeypro.com,http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000,http://localhost:8080
LOG_LEVEL=info

# Facultatif : fournir les deux variables ensemble pour créer/mettre à jour
# le Super Admin lors de `npm run prisma:seed`. Ne commitez jamais le vrai mot de passe.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

# Render : nombre de proxies de confiance entre Internet et l’API (généralement 1).
# Conserver 0 pour un accès local direct.
TRUST_PROXY_HOPS=0
# Documentation HTTP désactivée par défaut en production.
SWAGGER_ENABLED=false
