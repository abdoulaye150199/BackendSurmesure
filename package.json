{
  "name": "surmesure-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:load": "node scripts/run-load.cjs load",
    "test:load:smoke": "node scripts/run-load.cjs smoke",
    "test:load:config": "node --test load/config.test.mjs",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:passenger": "node dist/src/main.js",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "node scripts/migrate-deploy.cjs",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin:configure": "node scripts/configure-admin.cjs",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:quality": "jest --config jest.quality.config.cjs --runInBand --coverage",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm run test:quality"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.10.0",
    "argon2": "^0.43.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.4.0",
    "pino-http": "^10.4.0",
    "prisma": "^6.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.28.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "^2.5.0"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "@nestjs/swagger": {
      "js-yaml": "^5.4.1"
    },
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    }
  },
  "engines": {
    "node": ">=20.19.0 <25"
  }
}
